{
  "name": "orca-discord-presence",
  "version": "1.0.3",
  "private": true,
  "author": "Jonathan Marien",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build:panel": "bun scripts/build-panel.ts","build": "bun run build:panel && bun build src/main.ts --outfile dist/main.js --target node --format esm --banner '// Generated by bun build --target=node. Edit src/ instead.'",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "companion": "bun run companion/main.ts",
    "companion:compile": "bun build companion/main.ts --compile --outfile companion/orca-presence-companion"
  },
  "devDependencies": {
    "@types/bun": "1.4.1",
    "typescript": "7.0.2"
  }
}
